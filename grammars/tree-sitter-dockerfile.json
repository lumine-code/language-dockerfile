{
  "name": "Dockerfile",
  "scopeName": "source.dockerfile",
  "type": "tree-sitter",
  "parser": "tree-sitter-dockerfile",
  "injectionRegex": "^(dockerfile)$",
  // No `dockerignore`: it is gitignore syntax, not Dockerfile syntax, and
  // belongs to language-git's `source.gitignore`.
  "fileTypes": ["Dockerfile", "dockerfile", "Containerfile", "containerfile"],
  "comments": {
    "start": "# "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:camdencheek/tree-sitter-dockerfile#v0.2.0",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "tree-sitter-dockerfile/tree-sitter-dockerfile.wasm",
    "highlightsQuery": "tree-sitter-dockerfile/highlights.scm",
    "foldsQuery": "tree-sitter-dockerfile/folds.scm",
    "tagsQuery": "tree-sitter-dockerfile/tags.scm"
  }
}
